<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33A3FF12">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/lime" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/card_alt" />
                    <stroke android:width="1dp" android:color="@color/line" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
