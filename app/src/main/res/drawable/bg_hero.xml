<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/card" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.9"
                android:centerY="0.0"
                android:endColor="#00A3FF12"
                android:gradientRadius="320dp"
                android:startColor="#38A3FF12"
                android:type="radial" />
            <stroke android:width="1dp" android:color="#40A3FF12" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
